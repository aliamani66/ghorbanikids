                                        <?php endif; ?>
                                    </a>
                                </div>
                                <div class="gk-card-body">
                                    <div class="gk-card-badges-row">
                                        <?php if ($access_type === 'free'): ?>
                                            <span class="gk-badge gk-badge-free">🟢 رایگان</span>
                                        <?php else: ?>
