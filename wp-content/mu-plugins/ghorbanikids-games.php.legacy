<?php
/**
 * Plugin Name: GhorbaniKids Games Manager & Subscriptions
 * Description: مدیریت بازی‌های HTML5، قفل‌گذاری هوشمند، سیستم اشتراک ووکامرس، استایل اختصاصی حساب کاربری و هدر بار کاربر و سبد خرید.
 * Version: 5.7.0
 * Author: GhorbaniKids
 */

if (!defined('ABSPATH')) {
    exit;
}

class GhorbaniKids_Games {

    private static $instance = null;

    public static function get_instance() {
        if (self::$instance === null) {
            self::$instance = new self();
        }
        return self::$instance;
    }

    public function __construct() {
        add_action('init', [$this, 'register_cpt_and_taxonomies'], 0);
        add_action('add_meta_boxes', [$this, 'add_meta_boxes']);
        add_action('save_post_gk_game', [$this, 'save_meta_box_data']);
        add_filter('the_content', [$this, 'render_game_content']);
        add_shortcode('ghorbanikids_games', [$this, 'render_games_archive_shortcode']);
        add_shortcode('ghorbanikids_pricing', [$this, 'render_pricing_table_shortcode']);
        
        // پری‌لود پرسرعت فونت‌ها و تصاویر صفحه اول در هد
        add_action('wp_head', [$this, 'inject_resource_preloads'], 1);
        add_action('wp_head', [$this, 'inject_frontend_styles'], 10);
        add_action('avada_before_body_content', [$this, 'inject_top_navbar'], 1);
        add_action('wp_body_open', [$this, 'inject_top_navbar'], 1);
        add_action('wp_footer', [$this, 'inject_top_navbar'], 1);
        add_action('wp_footer', [$this, 'replace_avada_social_icons_script']);
        add_action('wp_footer', [$this, 'inject_auth_tabs_script']);
        
        add_filter('template_include', [$this, 'override_archive_template']);
        add_action('template_redirect', [$this, 'redirect_shop_to_pricing']);
        add_action('template_redirect', [$this, 'disable_cache_for_game_players']);
        add_filter('body_class', [$this, 'enforce_right_side_header_body_class'], 999);
        add_filter('woocommerce_return_to_shop_redirect', [$this, 'custom_return_to_shop_url']);
        add_filter('woocommerce_endpoint_dashboard_title', [$this, 'custom_dashboard_title']);
        add_filter('gettext', [$this, 'translate_dashboard_text'], 20, 3);

        // جایگزینی قطعی متن کپی‌رایت فوتر به همراه آیکون شبکه‌های اجتماعی
        add_action('avada_footer_copyright_content', [$this, 'render_custom_footer_copyright'], 1);

        // جلوگیری از کرش ثبت سفارش هنگام غیرفعال بودن تابع mail در هاست
        add_filter('pre_wp_mail', [$this, 'safe_pre_wp_mail'], 10, 2);

        // جلوگیری از توقف و کندی ناشی از اجرای درون‌برنامه‌ای کرون در هاست اشتراکی
        add_filter('cron_request', [$this, 'prevent_hanging_cron_loopback']);

        // حذف کامل باگ چشمک‌زدن و بسته شدن کمبوباکس‌ها (Select2/SelectWoo Conflict)
        add_action('wp_enqueue_scripts', [$this, 'disable_select2_bug'], 999);

        // مدیریت اشتراک و ووکامرس (فعال‌سازی در وضعیت تکمیل‌شده و درحال‌انجام)
        add_action('woocommerce_order_status_completed', [$this, 'handle_subscription_order']);
        add_action('woocommerce_order_status_processing', [$this, 'handle_subscription_order']);
        add_action('woocommerce_order_status_changed', [$this, 'handle_subscription_order_on_change'], 10, 3);
        add_action('show_user_profile', [$this, 'render_user_subscription_fields']);
        add_action('edit_user_profile', [$this, 'render_user_subscription_fields']);
        add_action('personal_options_update', [$this, 'save_user_subscription_fields']);
        add_action('edit_user_profile_update', [$this, 'save_user_subscription_fields']);

        // پیام پیشخوان حساب کاربری
        add_action('woocommerce_account_dashboard', [$this, 'render_dashboard_subscription_box'], 5);

        // بهینه‌سازی فرم تسویه‌حساب ووکامرس
        add_filter('woocommerce_checkout_fields', [$this, 'simplify_checkout_fields']);

        // تسهیل و رفع خطای ثبت‌نام در ووکامرس
        add_filter('woocommerce_min_password_strength', [$this, 'custom_min_password_strength']);
        add_action('woocommerce_created_customer', [$this, 'auto_login_new_user']);

        // بهینه‌سازی سرعت و لود اسکریپت‌ها
        add_action('wp_enqueue_scripts', [$this, 'optimize_woocommerce_assets'], 99);
        add_action('wp_print_scripts', [$this, 'disable_cart_fragments'], 100);
    }

    public function custom_dashboard_title() {
        return 'داشبورد';
    }

    public function translate_dashboard_text($translation, $text, $domain) {
        if (trim($text) === 'Dashboard') {
            return 'داشبورد';
        }
        return $translation;
    }

    public function custom_return_to_shop_url() {
        return home_url('/pricing/');
    }

    /**
     * پیش‌بارگذاری سریع (Preload) فونت‌های فارسی و تصویر شاخص صفحه اصلی برای لود صدم ثانیه‌ای
     */
    public function inject_resource_preloads() {
        if (is_front_page() || is_home()) {
            echo '<link rel="preload" as="image" href="https://ghorbanikids.ir/wp-content/uploads/2016/06/kids_conner_4.webp" fetchpriority="high">' . "\n";
            echo '<link rel="preload" as="image" href="https://ghorbanikids.ir/wp-content/uploads/2016/06/background.webp">' . "\n";
        }
        echo '<link rel="preload" href="https://ghorbanikids.ir/wp-content/uploads/2021/10/aviny-web.woff2" as="font" type="font/woff2" crossorigin>' . "\n";
        echo '<link rel="preload" href="https://ghorbanikids.ir/wp-content/uploads/2021/10/IRANSansXFaNum-Regular.woff2" as="font" type="font/woff2" crossorigin>' . "\n";
    }

    /**
     * سیستم تب‌های فعال و هوشمند ورود و عضویت در دسکتاپ و موبایل
     */
    public function inject_auth_tabs_script() {
        if (is_account_page() && !is_user_logged_in()) {
            ?>
            <script data-no-optimize="1">
                document.addEventListener("DOMContentLoaded", function() {
                    var customerLogin = document.getElementById("customer_login");
                    if (!customerLogin) return;

                    var col1 = customerLogin.querySelector(".col-1") || customerLogin.querySelector(".u-column1");
                    var col2 = customerLogin.querySelector(".col-2") || customerLogin.querySelector(".u-column2");

                    if (col1 && col2) {
                        if (!document.getElementById("gkAuthTabsHeader")) {
                            var tabsHeader = document.createElement("div");
                            tabsHeader.id = "gkAuthTabsHeader";
                            tabsHeader.className = "gk-auth-tabs-header";
                            tabsHeader.innerHTML = `
                                <button type="button" class="gk-auth-tab-btn active" data-target="login">🔑 ورود به حساب</button>
                                <button type="button" class="gk-auth-tab-btn" data-target="register">✨ عضویت و ثبت‌نام</button>
                            `;
                            customerLogin.parentNode.insertBefore(tabsHeader, customerLogin);

                            var tabBtns = tabsHeader.querySelectorAll(".gk-auth-tab-btn");
                            tabBtns.forEach(function(btn) {
                                btn.addEventListener("click", function(e) {
                                    e.preventDefault();
                                    tabBtns.forEach(function(b) { b.classList.remove("active"); });
                                    btn.classList.add("active");

                                    var target = btn.getAttribute("data-target");
                                    if (target === "login") {
                                        customerLogin.classList.remove("show-register");
                                        customerLogin.classList.add("show-login");
                                    } else {
                                        customerLogin.classList.remove("show-login");
                                        customerLogin.classList.add("show-register");
                                    }
                                });
                            });
                        }

                        // پیش‌فرض نمایش ورود
                        customerLogin.classList.remove("show-register");
                        customerLogin.classList.add("show-login");
                    }
                });
            </script>
            <?php
        }
    }

    /**
     * جایگزینی دقیق و شیک آیکون‌های قدیمی سایدبار و منوی موبایل با آیکون‌های اینستاگرام، تلگرام، بله و شماره تماس موبایل
